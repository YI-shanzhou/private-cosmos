[
  {
    "id": "phi_01",
    "text": "人不能两次踏入同一条河流",
    "source": "赫拉克利特",
    "tags": {
      "moods": [
        "诡谲"
      ],
      "domain": "philosophy",
      "logic": "悖论",
      "theme": "变化",
      "intensity": 4,
      "era": "古希腊"
    }
  },
  {
    "id": "phi_02",
    "text": "我知道我一无所知",
    "source": "苏格拉底",
    "tags": {
      "moods": [
        "孤寂"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "认知",
      "intensity": 2,
      "era": "古希腊"
    }
  },
  {
    "id": "phi_03",
    "text": "存在先于本质",
    "source": "萨特",
    "tags": {
      "moods": [
        "苍凉"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "存在",
      "intensity": 3,
      "era": "现代"
    }
  },
  {
    "id": "phi_04",
    "text": "凡是合理的都是现实的，凡是现实的都是合理的",
    "source": "黑格尔",
    "tags": {
      "moods": [
        "壮阔"
      ],
      "domain": "philosophy",
      "logic": "辩证",
      "theme": "理性",
      "intensity": 4,
      "era": "近代"
    }
  },
  {
    "id": "phi_05",
    "text": "上帝已死",
    "source": "尼采",
    "tags": {
      "moods": [
        "激烈"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "信仰",
      "intensity": 5,
      "era": "近代"
    }
  },
  {
    "id": "phi_06",
    "text": "未经审视的人生不值得过",
    "source": "苏格拉底",
    "tags": {
      "moods": [
        "孤寂"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "生命",
      "intensity": 2,
      "era": "古希腊"
    }
  },
  {
    "id": "phi_07",
    "text": "飞矢不动",
    "source": "芝诺悖论",
    "tags": {
      "moods": [
        "诡谲"
      ],
      "domain": "philosophy",
      "logic": "悖论",
      "theme": "运动",
      "intensity": 4,
      "era": "古希腊"
    }
  },
  {
    "id": "phi_08",
    "text": "天地不仁，以万物为刍狗",
    "source": "老子《道德经》",
    "tags": {
      "moods": [
        "苍凉",
        "壮阔"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "自然",
      "intensity": 4,
      "era": "先秦"
    }
  },
  {
    "id": "phi_09",
    "text": "一切坚固的东西都烟消云散了",
    "source": "马克思",
    "tags": {
      "moods": [
        "苍凉",
        "激烈"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "消解",
      "intensity": 5,
      "era": "近代"
    }
  },
  {
    "id": "phi_10",
    "text": "物自身不可知",
    "source": "康德",
    "tags": {
      "moods": [
        "诡谲",
        "孤寂"
      ],
      "domain": "philosophy",
      "logic": "定义",
      "theme": "认知",
      "intensity": 4,
      "era": "近代"
    }
  },
  {
    "id": "phi_11",
    "text": "我思故我在",
    "source": "笛卡尔",
    "tags": {
      "moods": [
        "孤寂",
        "希望"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "自我",
      "intensity": 2,
      "era": "近代"
    }
  },
  {
    "id": "phi_12",
    "text": "存在即被感知",
    "source": "贝克莱",
    "tags": {
      "moods": [
        "诡谲"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "感知",
      "intensity": 4,
      "era": "古典"
    }
  },
  {
    "id": "phi_13",
    "text": "他人即地狱",
    "source": "萨特",
    "tags": {
      "moods": [
        "苍凉",
        "激烈"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "他者",
      "intensity": 5,
      "era": "现代"
    }
  },
  {
    "id": "phi_14",
    "text": "凡是杀不死我的，必使我更强大",
    "source": "尼采",
    "tags": {
      "moods": [
        "激烈",
        "壮阔"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "力量",
      "intensity": 5,
      "era": "近代"
    }
  },
  {
    "id": "phi_15",
    "text": "道生一，一生二，二生三，三生万物",
    "source": "老子《道德经》",
    "tags": {
      "moods": [
        "壮阔",
        "神秘"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "生成",
      "intensity": 4,
      "era": "先秦"
    }
  },
  {
    "id": "phi_16",
    "text": "上善若水，水善利万物而不争",
    "source": "老子《道德经》",
    "tags": {
      "moods": [
        "宁静",
        "辽阔"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "柔德",
      "intensity": 3,
      "era": "先秦"
    }
  },
  {
    "id": "phi_17",
    "text": "天地与我并生，万物与我为一",
    "source": "庄子《齐物论》",
    "tags": {
      "moods": [
        "壮阔",
        "宁静"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "齐物",
      "intensity": 3,
      "era": "先秦"
    }
  },
  {
    "id": "phi_18",
    "text": "不知周之梦为胡蝶与，胡蝶之梦为周与",
    "source": "庄子《齐物论》",
    "tags": {
      "moods": [
        "诡谲",
        "神秘"
      ],
      "domain": "philosophy",
      "logic": "悖论",
      "theme": "梦境",
      "intensity": 4,
      "era": "先秦"
    }
  },
  {
    "id": "phi_19",
    "text": "至人无己，神人无功，圣人无名",
    "source": "庄子《逍遥游》",
    "tags": {
      "moods": [
        "辽阔",
        "宁静"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "逍遥",
      "intensity": 3,
      "era": "先秦"
    }
  },
  {
    "id": "phi_20",
    "text": "色即是空，空即是色",
    "source": "《般若波罗蜜多心经》",
    "tags": {
      "moods": [
        "诡谲",
        "宁静"
      ],
      "domain": "philosophy",
      "logic": "辩证",
      "theme": "空性",
      "intensity": 3,
      "era": "古代"
    }
  },
  {
    "id": "phi_21",
    "text": "一切有为法，如梦幻泡影，如露亦如电，应作如是观",
    "source": "《金刚经》",
    "tags": {
      "moods": [
        "苍凉",
        "诡谲"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "无常",
      "intensity": 4,
      "era": "古代"
    }
  },
  {
    "id": "phi_22",
    "text": "幸福不在于占有牲畜，也不在于占有黄金，幸福在于灵魂的安宁",
    "source": "伊壁鸠鲁",
    "tags": {
      "moods": [
        "宁静",
        "希望"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "幸福",
      "intensity": 2,
      "era": "古希腊"
    }
  },
  {
    "id": "phi_23",
    "text": "如果你长久凝视深渊，深渊也将回望你",
    "source": "尼采",
    "tags": {
      "moods": [
        "诡谲",
        "苍凉"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "深渊",
      "intensity": 4,
      "era": "近代"
    }
  },
  {
    "id": "phi_24",
    "text": "人是万物的尺度",
    "source": "普罗泰戈拉",
    "tags": {
      "moods": [
        "壮阔",
        "孤寂"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "度量",
      "intensity": 4,
      "era": "古希腊"
    }
  },
  {
    "id": "phi_25",
    "text": "世界是我的表象",
    "source": "叔本华",
    "tags": {
      "moods": [
        "诡谲",
        "苍凉"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "表象",
      "intensity": 4,
      "era": "近代"
    }
  },
  {
    "id": "phi_26",
    "text": "时间是构成我的实体",
    "source": "柏格森",
    "tags": {
      "moods": [
        "神秘",
        "苍凉"
      ],
      "domain": "philosophy",
      "logic": "定义",
      "theme": "时间",
      "intensity": 3,
      "era": "现代"
    }
  },
  {
    "id": "phi_27",
    "text": "语言的边界即是世界的边界",
    "source": "维特根斯坦",
    "tags": {
      "moods": [
        "孤寂",
        "诡谲"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "语言",
      "intensity": 4,
      "era": "现代"
    }
  },
  {
    "id": "phi_28",
    "text": "存在是一种涌现，而非一种状态",
    "source": "海德格尔",
    "tags": {
      "moods": [
        "神秘",
        "壮阔"
      ],
      "domain": "philosophy",
      "logic": "定义",
      "theme": "涌现",
      "intensity": 4,
      "era": "现代"
    }
  },
  {
    "id": "phi_29",
    "text": "自由不是想做什么就做什么，而是不想做什么就能不做什么",
    "source": "康德",
    "tags": {
      "moods": [
        "孤寂",
        "希望"
      ],
      "domain": "philosophy",
      "logic": "命题",
      "theme": "自由",
      "intensity": 2,
      "era": "近代"
    }
  },
  {
    "id": "phi_30",
    "text": "无穷是一个无法抵达的彼岸，但正是对无穷的追逐定义了有限者的尊严",
    "source": "帕斯卡",
    "tags": {
      "moods": [
        "壮阔",
        "苍凉"
      ],
      "domain": "philosophy",
      "logic": "辩证",
      "theme": "无穷",
      "intensity": 4,
      "era": "近代"
    }
  }
]